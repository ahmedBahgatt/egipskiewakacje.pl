# =============================================================================
# Egipskie Wakacje - environment example
# =============================================================================
# Copy to .env.local and fill in as needed. NEVER commit real secrets.
# The public site builds fully in local-content mode with NO secrets required.
# =============================================================================

# Content source: "local" (typed source files, default) or "sanity".
# BUILD-ONLY (not NEXT_PUBLIC_): source selection is a server/build concern.
# Leave as "local" until the Sanity dataset is seeded (see SANITY_SETUP.md).
# (The old name NEXT_PUBLIC_CONTENT_SOURCE is still honoured as a fallback.)
CONTENT_SOURCE=local

# --- Sanity (public config) -------------------------------------------------
# Safe to expose. Used only when NEXT_PUBLIC_CONTENT_SOURCE=sanity.
NEXT_PUBLIC_SANITY_PROJECT_ID=ej04dib0
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# --- Sanity READ token (SERVER / BUILD ONLY) --------------------------------
# The production dataset is PRIVATE (project has private-dataset access control),
# so a `sanity`-mode static build reads content with this least-privilege Viewer
# token. MUST NOT be prefixed with NEXT_PUBLIC_ (never shipped to the browser);
# the build runs in Node, so the token stays on the build machine only.
# Create at https://www.sanity.io/manage -> ej04dib0 -> API -> Tokens (Viewer role).
# In CI: add as GitHub Actions secret SANITY_API_READ_TOKEN.
SANITY_API_READ_TOKEN=

# --- Sanity WRITE token (SEED SCRIPT ONLY) ----------------------------------
# Required ONLY to run studio/seed (uploads images + writes documents).
# MUST NOT be prefixed with NEXT_PUBLIC_. Never shipped to the browser.
# Create at https://www.sanity.io/manage -> API -> Tokens (Editor role).
# Lives in studio/.env.local (git-ignored). Rotate after the migration.
SANITY_WRITE_TOKEN=

# --- Analytics (optional, disabled by default) ------------------------------
# Leave empty to keep analytics as a no-op (no cookies, no tracking, no banner).
# See ANALYTICS.md before enabling anything here.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=

# --- Site URL (used for canonical/sitemap; has a safe default) --------------
NEXT_PUBLIC_SITE_URL=https://egipskiewakacje.pl
