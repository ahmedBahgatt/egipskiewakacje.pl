# =============================================================================
# Sanity Studio - environment example  (studio/ package only)
# =============================================================================
# Copy to studio/.env and fill in. studio/.env and studio/.env.local are
# git-ignored (see the repository .gitignore). NEVER commit real tokens.
#
# This file belongs to the CMS package only. The Next.js frontend has its own
# .env.example in the repository root and never reads anything from here.
# =============================================================================

# --- Studio target (safe to expose) -----------------------------------------
# Baked into the Studio bundle at build time. Anything prefixed with
# SANITY_STUDIO_ is PUBLIC - never put a secret behind that prefix.
SANITY_STUDIO_PROJECT_ID=ej04dib0
SANITY_STUDIO_DATASET=production

# --- Seed script token (SECRET - scripts only) ------------------------------
# Required ONLY by `npm run seed`. Create it at:
#   https://www.sanity.io/manage -> project ej04dib0 -> API -> Tokens
#   Add API token -> name "seed" -> permissions: Editor
# The value is shown once; store it in a password manager.
#
# WARNING
#   - Do NOT prefix this with NEXT_PUBLIC_ or SANITY_STUDIO_. Either prefix
#     ships the token to the browser, handing anyone write access to the
#     dataset.
#   - Do NOT put it in the frontend .env.local used by `next build`.
#   - Rotate it in sanity.io/manage if it ever lands in a log, a commit or a
#     screen share.
#
# Without this variable the seed runs as a dry run and exits cleanly.
SANITY_WRITE_TOKEN=
