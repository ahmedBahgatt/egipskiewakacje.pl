{
  "name": "egipskie-wakacje-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Sanity Studio (CMS) for Egipskie Wakacje. Standalone package - never part of the Next.js static export.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "generate": "tsx --tsconfig ./seed/tsconfig.json ./seed/generate.ts",
    "seed:dry": "npm run generate && node ./seed/seed.mjs --dry-run",
    "seed": "npm run generate && node ./seed/seed.mjs",
    "parity": "tsx --tsconfig ./seed/tsconfig.json ./seed/parity.ts"
  },
  "dependencies": {
    "@sanity/client": "^6.22.0",
    "@sanity/vision": "^3.68.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanity": "^3.68.0",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
